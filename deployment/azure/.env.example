# Azure environment config — copy this to .env on your VM and fill in values
# DO NOT commit .env to git

# ── Required ──────────────────────────────────────────────────────────────────
# Public IP or domain of the Azure VM (no http://)
# Example: CVAT_HOST=20.123.45.67  OR  CVAT_HOST=mycvat.eastus.cloudapp.azure.com
CVAT_HOST=YOUR_VM_PUBLIC_IP_HERE

# Strong random string — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=change-me-please

# ── Image versions ─────────────────────────────────────────────────────────────
# Use 'dev' to build locally from source, or pin to a release tag
CVAT_VERSION=dev

# ── Optional tuning ───────────────────────────────────────────────────────────
# Increase if workers crash on large video uploads
NUMPROCS=2
